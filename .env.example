# Local development defaults. The Windows README generates unique local secrets.
APP_ENV=development
APP_SECRET_KEY=
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Container-to-container addresses; keep postgres and redis as hostnames.
POSTGRES_DB=firstcomment
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/firstcomment
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# Generate once, then retain these values when restarting or upgrading.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
ACCESS_TOKEN_TTL_MINUTES=30

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=firstcomment-media

# Leave mock enabled for the walkthrough; no model credentials are needed.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_FAST=mock-fast-v1
LLM_MODEL_NORMAL=mock-normal-v1
LLM_TIMEOUT_SECONDS=5

# Persisted workspace settings in the UI override these initial mode defaults.
AUTO_PUBLISH_DEFAULT=false
COMMENT_MODE=REVIEW
RISK_ALLOW_THRESHOLD=0.30
RISK_BLOCK_THRESHOLD=0.65
QUALITY_ALLOW_THRESHOLD=0.80
QUALITY_REVIEW_THRESHOLD=0.65
DUPLICATE_BLOCK_THRESHOLD=0.90
DUPLICATE_REVIEW_THRESHOLD=0.82

SSE_HEARTBEAT_SECONDS=15
PROMETHEUS_PORT=9090
