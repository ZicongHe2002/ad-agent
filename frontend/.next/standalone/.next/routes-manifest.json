{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/accounts",
      "regex": "^/accounts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accounts(?:/)?$"
    },
    {
      "page": "/analytics",
      "regex": "^/analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/analytics(?:/)?$"
    },
    {
      "page": "/brand",
      "regex": "^/brand(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/brand(?:/)?$"
    },
    {
      "page": "/campaigns",
      "regex": "^/campaigns(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/campaigns(?:/)?$"
    },
    {
      "page": "/comments",
      "regex": "^/comments(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/comments(?:/)?$"
    },
    {
      "page": "/creators",
      "regex": "^/creators(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/creators(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/live",
      "regex": "^/live(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/live(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/posts",
      "regex": "^/posts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/posts(?:/)?$"
    },
    {
      "page": "/review",
      "regex": "^/review(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/review(?:/)?$"
    },
    {
      "page": "/risk",
      "regex": "^/risk(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/risk(?:/)?$"
    },
    {
      "page": "/settings",
      "regex": "^/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/settings(?:/)?$"
    }
